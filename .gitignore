# The environment `uv sync --locked` builds. It is derived from uv.lock, which is
# tracked, so a clone rebuilds it rather than receiving it.
.venv/

# Interpreter and build output.
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Tool caches, derived from the tree and rebuilt on demand.
.mypy_cache/
.ruff_cache/

# Where the measurement of #15 writes what it counted. A data file about one run
# on one machine, which is not a fact about this tree, and it appears in the
# working copy the first time anybody measures the suite.
.coverage
.coverage.*

